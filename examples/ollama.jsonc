{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [{
    // --copy path. Linked installs must keep the real path written by install.sh.
    "package": "./packages/jebediah",
    "options": {
      "embedding": {
        "preset": "ollama-embeddinggemma2",
        "model": "embeddinggemma-2:latest",
        "baseURL": "http://localhost:11434",
        "dimensions": 768,
        "timeoutSeconds": 120,
        "keepAlive": "30m",
      },
      "maxDistance": { "graph": 0.38, "attacks": 0.38 },
    },
  }],
}
